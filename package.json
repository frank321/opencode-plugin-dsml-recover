{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "opencode-plugin-dsml-recover",
  "version": "0.3.0",
  "type": "module",
  "license": "MIT",
  "description": "OpenCode V2 plugin that recovers DeepSeek DSML tool calls leaked as assistant text",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "check": "bun run typecheck && bun test",
    "build": "bun build ./src/index.ts --outdir ./dist --target bun --format esm --external @opencode/plugin --external @ai-sdk/provider",
    "prepublishOnly": "bun run check && bun run build"
  },
  "dependencies": {
    "@ai-sdk/provider": "^3.0.8",
    "@opencode/plugin": "2.0.22"
  },
  "devDependencies": {
    "bun-types": "latest",
    "typescript": "^5.6.0"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "deepseek",
    "dsml",
    "tool-calls"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/frank321/opencode-plugin-dsml-recover.git"
  },
  "homepage": "https://github.com/frank321/opencode-plugin-dsml-recover",
  "bugs": {
    "url": "https://github.com/frank321/opencode-plugin-dsml-recover/issues"
  },
  "author": "frank321",
  "contributors": [
    "bendtherules (original project: opencode-plugin-dsml-fix)"
  ]
}
